{
  "name": "homebridge-ssh-platform",
  "displayName": "Homebridge SSH",
  "type": "module",
  "version": "0.1.3",
  "description": "Expose remote shell scripts as native HomeKit accessories via SSH (switches and garage door openers).",
  "author": "Dragos Burciu",
  "license": "Apache-2.0",
  "homepage": "https://github.com/x-dragos/homebridge-ssh-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-dragos/homebridge-ssh-platform.git"
  },
  "bugs": {
    "url": "https://github.com/x-dragos/homebridge-ssh-platform/issues"
  },
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "homebridge-ui/",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "ssh",
    "garage-door",
    "switch"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run verify && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "deploy:pi": "bash bin/deploy-pi.sh",
    "logs:pi": "bash bin/logs-pi.sh",
    "test:ssh": "bash bin/test-ssh.sh"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "ssh2": "^1.15.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@types/ssh2": "^1.15.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^1.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bash bin/pre-commit.sh"
  }
}
