# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# SSH target for deploy-pi.sh / logs-pi.sh / test-ssh.sh.
PI_HOST=youruser@homebridge.local

# Optional: override the restart command on Pi A.
# Leave unset for auto-detection (hb-service / systemctl).
# PI_RESTART_CMD="sudo hb-service restart"
